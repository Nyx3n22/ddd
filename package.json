{
  "name": "elenem",
  "version": "2.0.0",
  "type": "module",
  "description": "ELENEM — RPG 2D, rzut 3/4 z góry, pixel art, otwarty świat, rok 1430 (Vertical Slice)",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 5173",
    "typecheck": "tsc --noEmit",
    "i18n:keys": "python3 tools/i18n/keys.py",
    "i18n:build": "python3 tools/i18n/build.py",
    "i18n:check": "python3 tools/i18n/check.py",
    "smoke": "npm run build && node tools/smoke.mjs",
    "verify": "npm run typecheck && npm run i18n:check && npm run smoke"
  },
  "devDependencies": {
    "typescript": "^5.4.5",
    "vite": "^5.2.0",
    "jsdom": "^24.1.0"
  }
}
